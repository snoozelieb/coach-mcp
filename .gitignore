# Environment variables and credentials
.env
.garth/

# Local data backups (personal health data)
data-backups/
data/*.bak

# Personal data: everything under data/ is private by default (athlete profile,
# plans, training_program, fitness/sleep history, coaching memory, investigation
# output, backups). Only the generic methodology template is committed — new
# data files are ignored automatically instead of needing a line here.
data/*
!data/methodology.json

# MCP builder scaffolding
.agents/

# MCP registry publisher CLI (local tool binary, downloaded per release)
mcp-publisher
mcp-publisher.exe

# Temp files from Claude Code
tmpclaude-*

# Log files
*.log

# Test fixtures (contains personal health data; sanitized fallback is committed at tests/fixtures/garmin_sample.json)
test_fixtures.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local state (skills are shared and committed; the rest —
# settings.local.json, agent-memory — stays personal/local)
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db
nul
garmin_tokens.json
